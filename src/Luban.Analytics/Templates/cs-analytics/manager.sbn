using System;
using System.Collections.Generic;

{{namespace_with_grace_begin model.namespace}}
    /// <summary>
    /// 强类型业务埋点入口。公共参数采集、会话状态和发送管理由目标统计框架负责。
    /// </summary>
    public static class {{ model.manager }}
    {
        private static IAnalyticsEventSink _eventSink;
        private static IAnalyticsCommonParametersCollector _commonParametersCollector;

        /// <summary>
        /// 绑定接收生成事件的统计框架。传入 null 时停止接收后续事件。
        /// </summary>
        public static void BindEventSink(IAnalyticsEventSink eventSink)
        {
            if (ReferenceEquals(_eventSink, eventSink))
            {
                return;
            }

            _eventSink?.SetCommonParametersCollector(null);
            _eventSink = eventSink;
            _eventSink?.SetCommonParametersCollector(_commonParametersCollector);
        }

        /// <summary>
        /// 注册游戏基础参数采集器，并同步到当前事件接收器。
        /// </summary>
        /// <param name="collector">游戏采集器；传入 null 清除游戏采集，但保留接收框架提供的字段。</param>
        public static void BindCommonParametersCollector(IAnalyticsCommonParametersCollector collector)
        {
            _commonParametersCollector = collector;
            _eventSink?.SetCommonParametersCollector(collector);
        }

        /// <summary>
        /// 提交事件定义、已生成的一次性键和当前参数，未绑定接收器时忽略事件。
        /// </summary>
        private static void Submit(AnalyticsEventDefinition definition, string onceKey, IReadOnlyDictionary<string, object> values)
        {
            _eventSink?.Submit(definition, onceKey, values);
        }

{{~ for event in model.events ~}}
        /// <summary>
        /// {{escape_comment event.comment}}
        /// </summary>
        public static AnalyticsEventDefinition {{ event.definition }} { get; } = new AnalyticsEventDefinition(
            {{ event.event_name }},
            {{ if event.receiver_ids == "" }}Array.Empty<string>(){{ else }}new string[] { {{ event.receiver_ids }} }{{ end }},
            {{ if event.is_funnel }}true{{ else }}false{{ end }},
            {{ event.step_field }});

        /// <summary>
        /// {{escape_comment event.comment}}
        /// </summary>
        public static void {{ event.name }}({{ if event.has_parameters }}{{ event.parameters_type }} {{ event.parameters_argument }}{{ end }})
        {
{{~ if event.has_parameters ~}}
            if ({{ event.parameters_argument }} == null)
            {
                throw new ArgumentNullException(nameof({{ event.parameters_argument }}));
            }

            var values = new Dictionary<string, object>(StringComparer.Ordinal);
            {{ event.parameters_argument }}.AppendTo(values);
{{~ else ~}}
            var values = new Dictionary<string, object>(StringComparer.Ordinal);
{{~ end ~}}

            Submit({{ event.definition }}, {{ if event.is_funnel }}AnalyticsEnumValues.ToOnceKey({{ event.parameters_argument }}.{{ event.step_property }}){{ else }}""{{ end }}, values);
        }
{{~ if !for.last ~}}

{{~ end ~}}
{{~ end ~}}
    }
{{namespace_with_grace_end model.namespace}}
