using System;

{{namespace_with_grace_begin model.namespace}}
    /// <summary>
    /// 词典生成的统计枚举：{{ enum.name }}。
    /// </summary>
    public enum {{ enum.name }}
    {
{{~ for item in enum.items ~}}
        /// <summary>
        /// {{if item.comment == ""}}统计枚举成员：{{ item.name }}。{{else}}{{escape_comment item.comment}}{{end}}
        /// </summary>
        {{ item.name }} = {{ item.value }},
{{~ if !for.last ~}}

{{~ end ~}}
{{~ end ~}}
    }

    /// <summary>
    /// 将强类型枚举转换为表中配置的上报值。
    /// </summary>
    public static partial class AnalyticsEnumValues
    {
        /// <summary>
        /// 返回枚举成员的上报值，未定义的成员抛出参数异常。
        /// </summary>
        public static string ToReportValue({{ enum.name }} value)
        {
            switch (value)
            {
{{~ for item in enum.items ~}}
                case {{ enum.name }}.{{ item.name }}:
                    return {{ item.report_value }};
{{~ end ~}}
                default:
                    throw new ArgumentOutOfRangeException(nameof(value), value, "Unknown analytics enum member.");
            }
        }
{{~ if enum.is_funnel_step ~}}

        /// <summary>
        /// 返回导表时确定的步骤一次性键，未定义的成员抛出参数异常。
        /// </summary>
        public static string ToOnceKey({{ enum.name }} value)
        {
            switch (value)
            {
{{~ for item in enum.items ~}}
                case {{ enum.name }}.{{ item.name }}:
                    return {{ item.once_key }};
{{~ end ~}}
                default:
                    throw new ArgumentOutOfRangeException(nameof(value), value, "Unknown analytics enum member.");
            }
        }
{{~ end ~}}
    }
{{namespace_with_grace_end model.namespace}}
